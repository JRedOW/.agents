# Claude Code session/resume state; large and machine-local
sessions/
backups/
cache/
statsig/
todos/
shell-snapshots/
.last-cleanup

# Secrets; never commit or deploy
.credentials.json

# Shipped by Claude Code itself; churns with app updates
skills/.system/

# Synced/signed policy and settings; regenerated from Anthropic
policy-limits.json*
remote-settings.json*

# Runtime-downloaded marketplace and synced plugin/skill state
plugins/
skills/synced/

# Live settings: Orca injects machine-local hooks into this exact path
# (~/.claude symlinks here). Restore from settings.template.json.
settings.json

# Per-session temp state
session-env/

# Prompt history and per-project session data
history.jsonl
projects/

# MCP auth prompt cache
mcp-needs-auth-cache.json

# MCP server protocol discovery cache
state/

# Statusline and mode files installed by plugins (caveman, ponytail) at startup
hooks/caveman-statusline.sh
ponytail-statusline.sh
ponytail-modes/

# Daemon runtime state on this machine
daemon/
daemon.lock
daemon.log
daemon.status.json
jobs/

# Generated plan files
plans/

# File history snapshots
file-history/

# Orca agent-view setup state and its injected keybinding
orca-agent-view.json
keybindings.json
