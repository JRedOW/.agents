{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "lsp": true,
  "permission": {
    "*": "ask",
    "bash": {
      "git commit *": "deny",
      "git diff *": "allow",
      "git log *": "allow",
      "git push *": "deny",
      "git show *": "allow",
      "git status *": "allow",
      "head *": "allow",
      "tail *": "allow"
    },
    "context7_query-docs": {
      "*": "allow"
    },
    "context7_resolve-library-id": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "mcp-for-blender*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "task": {
      "explore": "allow"
    },
    "todoread": "allow",
    "todowrite": "allow"
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.jnet.moe/v1"
      },
      "models": {
        "opencode-go/mimo-v2.5": {
          "name": "OpenCode Go Mimo v2.5"
        }
      }
    }
  },
  "agent": {
    "blender": {
      "mode": "all"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail@5.3.2",
    "./plugins/caveman"
  ],
  "mcp": {
    "mcp-for-blender": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-for-blender@2.2.7"
      ],
      "environment": {
        "BLENDER_MCP_SAFE_MODE": "1"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
